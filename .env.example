# Copy this file to .env and add your own keys.
# .env is excluded via .gitignore and is NEVER committed.

# Anthropic API key (https://console.anthropic.com/) - for the AI analysis pipeline
ANTHROPIC_API_KEY=sk-ant-your-key-here

# FRED API key (https://fred.stlouisfed.org/docs/api/api_key.html) - for macro data (rates, inflation)
FRED_API_KEY=your-fred-key-here

# Optional: override the model (default: claude-sonnet-5)
# STOCK_RESEARCH_MODEL=claude-sonnet-5

# Kopiere diese Datei nach .env und trage deine eigenen Keys ein.
# .env ist per .gitignore ausgeschlossen und wird NIE committet.

# Anthropic API-Key (https://console.anthropic.com/) - fuer die KI-Analyse-Pipeline
ANTHROPIC_API_KEY=sk-ant-your-key-here

# FRED API-Key (https://fred.stlouisfed.org/docs/api/api_key.html) - fuer Makro-Daten (Zinsen, Inflation)
FRED_API_KEY=your-fred-key-here

# Optional: Modell ueberschreiben (Default: claude-sonnet-5)
# STOCK_RESEARCH_MODEL=claude-sonnet-5
